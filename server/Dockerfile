# Dev image — favors fast iteration (nodemon + bind mount) over a small final size.
# The production, multi-stage version of this file is built in Phase 19.
#
# node:20-slim (Debian), NOT node:20-alpine: onnxruntime-node — a dependency
# of @xenova/transformers, used for local embeddings — ships a prebuilt
# native binary linked against glibc. Alpine uses musl libc instead, so the
# binary fails to load at runtime (ld-linux-x86-64.so.2: No such file or
# directory) and crashes the whole process the first time embeddings are
# generated, not at build time — this only surfaces when /process actually
# runs. Alpine's glibc-compatibility packages are explicitly documented as
# "experimental" and unreliable for this class of problem, so switching the
# base image is the correct fix, not a workaround.
FROM node:20-slim

WORKDIR /usr/src/app

# Only package.json is copied — deliberately NOT package-lock.json. That
# lockfile has been regenerated by `npm install` on Windows at several
# points during development, and a lockfile's exact resolved dependency
# tree can bake in platform-specific choices for native packages (sharp,
# onnxruntime-node, @napi-rs/canvas). Three different native-binary
# failures were traced back to this same root cause. Installing from
# package.json's version ranges alone, with no lockfile present, forces
# npm to do a completely fresh resolution against the platform actually
# running the install — this container, Linux x64 — every time, rather
# than inheriting whatever a Windows npm run happened to lock in.
COPY package.json ./

# Clean npm's cache first: it can hold a prebuilt native binary fetched
# during an earlier build (e.g. from before the base image was switched
# from Alpine to Debian) and reuse it even when nothing else points to
# musl. That is confirmed to be exactly what was happening here — sharp's
# installer kept producing a musl (Alpine) binary inside this glibc
# (Debian) image no matter what other flags were set, because a stale
# musl prebuild was sitting in the cache. --libc=glibc makes the target
# explicit rather than relying on auto-detection at all.
RUN npm cache clean --force && npm install --os=linux --cpu=x64 --libc=glibc

# Source is bind-mounted over this in docker-compose.dev.yml,
# this COPY just makes the image runnable standalone too.
COPY . .

EXPOSE 8000

CMD ["npm", "run", "dev"]