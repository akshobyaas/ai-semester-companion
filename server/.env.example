# Application
APP_NAME=AI Learning Engine
NODE_ENV=development
PORT=8000

# Database — service name "mongo" resolves inside the Docker network
MONGODB_URI=mongodb://mongo:27017/learningagent

# Auth
JWT_SECRET=change-this-secret-key-in-production
JWT_EXPIRES_IN=1d

# LLM providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
DEFAULT_PROVIDER=openai

# LLM response cache (confirmed in Phase 7 — NOT dead config, contrary to the
# earlier Phase 0 note; used for 1hr TTL caching of generate() responses)
REDIS_URL=redis://redis:6379

# Embeddings / Vector search (Atlas Vector Search, configured in Phase 6)
EMBEDDING_MODEL=text-embedding-3-small
ATLAS_VECTOR_INDEX=vector_index

# File storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=52428800

# CORS
CLIENT_ORIGIN=http://localhost:5173
